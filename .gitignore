# Universal .gitignore - Language Agnostic

# ============================================
# IDE and Editor Files
# ============================================
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ============================================
# Local editor/assistant state
# ============================================
.claude/
*.log

# ============================================
# Archive (Old/Backup Files)
# ============================================
archive/

# ============================================
# Python
# ============================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
venv/
ENV/
env/
.venv
pip-log.txt
pip-delete-this-directory.txt
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.mypy_cache/
.dmypy.json
dmypy.json

# ============================================
# JavaScript / Node
# ============================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm
.yarn-integrity
.pnp.*
dist/
build/
.next/
out/
.cache/
.parcel-cache/

# ============================================
# Go
# ============================================
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out
go.work

# ============================================
# Rust
# ============================================
target/
**/*.rs.bk
Cargo.lock

# ============================================
# Java
# ============================================
*.class
*.jar
*.war
*.ear
*.nar
hs_err_pid*
target/
.gradle/
build/
.settings/
.classpath
.project

# ============================================
# C/C++
# ============================================
*.o
*.obj
*.exe
*.out
*.app
*.i*86
*.x86_64
*.hex
CMakeFiles/
CMakeCache.txt
cmake_install.cmake

# ============================================
# Environment Variables & Secrets
# ============================================
.env
.env.local
.env.*.local
*.pem
*.key
*.cert
secrets/
credentials/

# ============================================
# Database
# ============================================
*.sqlite
*.sqlite3
*.db

# ============================================
# Test Reports & Coverage
# ============================================
reports/
coverage/
test-results/
allure-results/
allure-report/
*.xml
junit.xml

# ============================================
# Temporary Files
# ============================================
tmp/
temp/
*.tmp
*.bak
*.backup

# ============================================
# OS Specific
# ============================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# ============================================
# Documentation Build
# ============================================
_build/
_static/
_templates/
site/

# ============================================
# Dot Folders & Files (IDE/Config)
# ============================================
# Ignore all dot folders and files
.*
.*/

# Keep These (Exceptions)
!.gitignore
!.gitkeep
!.env.example
!.github/

# ============================================
# Editor Rules (IDE-specific)
# ============================================
.cursorrules
.windsurfrules

# ============================================
# Proprietary Workflow Documentation
# ============================================
# These files contain months of refined AI workflow knowledge
# They are intellectual property and should NOT be shared publicly
CLAUDE.md
MCP_USAGE_GUIDE.md

# Generated output files
output/*.md
output/*.csv

# Uploaded PRD files (keep directory)
prd/*.pdf
prd/*.png
prd/*.jpg
prd/*.jpeg
prd/*.txt
!prd/.gitkeep
output/*.json

# --- inputs and generated artifacts: never commit ---
prd/*.pdf
prd/*.png
prd/*.jpg
prd/*.txt
output/
archive/
lightrag_setup/output/
lightrag_setup/data/
*_config_snapshot.json
*_changelog.json
htmlcov/
.env

# harness template state
.template.env
.template.modules
.claude/logs/

# binary docs cannot be scrubbed
docs/**/*.pdf
*.pdf

# Vite build output. Generated by `npm run build` in frontend/; the API mounts
# it when present and works without it.
frontend/static/
frontend/dist/

# Local editor/assistant config; may contain API tokens
.mcp.json
